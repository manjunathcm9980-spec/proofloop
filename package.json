{
  "name": "proofloop",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build:lambdas": "esbuild backend/lambdas/problems/list.ts backend/lambdas/problems/create.ts backend/lambdas/problems/get.ts backend/lambdas/claim/claimProblem.ts backend/lambdas/logs/addBuildLog.ts backend/lambdas/proof/submitProof.ts backend/lambdas/proof/validateProof.ts backend/lambdas/wall/getWall.ts backend/lambdas/storage/getUploadUrl.ts --bundle --platform=node --target=node20 --outdir=dist/lambdas",
    "build": "tsc -b && vite build",
    "build:all": "npm run build:lambdas && npm run build",
    "lint": "tsc --noEmit",
    "preview": "vite preview",
    "server": "tsx backend/server.ts"
  },
  "dependencies": {
    "@aws-sdk/client-cognito-identity-provider": "^3.750.0",
    "@aws-sdk/client-dynamodb": "^3.750.0",
    "@aws-sdk/client-s3": "^3.750.0",
    "@aws-sdk/lib-dynamodb": "^3.750.0",
    "@aws-sdk/s3-request-presigner": "^3.750.0",
    "@types/three": "^0.186.0",
    "clsx": "^2.1.1",
    "cors": "^2.8.5",
    "express": "^4.21.2",
    "lucide-react": "^0.475.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.2.0",
    "tailwind-merge": "^3.0.1",
    "three": "^0.186.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.7",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/node": "^22.13.4",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@vitejs/plugin-react": "^4.3.4",
    "esbuild": "^0.28.2",
    "tailwindcss": "^4.0.7",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3",
    "vite": "^6.1.0"
  }
}
